# ==============================================================================
# FastAPI Backend Configuration
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5435/ckan_recommendation

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# Authentication & Security
JWT_SECRET=ckan_secret_jwt_key_2026_super_secure_production_ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning & Knowledge Graph Paths (relative to backend folder)
DATA_DIR=data/movie
CKAN_MODEL_PATH=models/ckan_movie.pt
CKAN_CACHE_PATH=models/cache/propagation_cache.pkl
CKAN_METADATA_PATH=data/movie/movies_metadata.json
CKAN_KG_PATH=data/movie/kg_final.npy

BATCH_SIZE=2048
USE_CUDA=false

