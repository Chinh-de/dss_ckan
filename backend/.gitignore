# Backend specific gitignore
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/




.env
.env.*
!.env.example

# Large model weights & caches
models/*.pt
models/*.pth
models/*.bin
models/cache/*.pkl
models/cache/*.npy
!models/.gitkeep
!models/cache/.gitkeep

