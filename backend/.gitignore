# Backend specific gitignore
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/




.env
.env.*
!.env.example

# Large model weights & caches
models/*.pt
models/*.pth
models/*.bin
models/cache/*.pkl
models/cache/*.npy
!models/.gitkeep
!models/cache/.gitkeep


# Likes/hides recorded from the demo UI
data/session_feedback.json
data/session_feedback.json.tmp

# Wikidata lookups cached by app/scripts/build_entity_names.py
models/cache/wikidata_credits.json
