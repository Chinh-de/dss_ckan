# 4. Large ML Checkpoints & Intermediate Caches
# Keep directories tracked via .gitkeep
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin
backend/models/cache/*.pkl
backend/models/cache/*.npy
!backend/models/.gitkeep
!backend/models/cache/.gitkeep

